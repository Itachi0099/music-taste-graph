# Spotify OAuth Credentials
# Client ID is public in PKCE, but configured here for backend exchange
SPOTIFY_CLIENT_ID=663e5f2a2950473ba037426e5343b8df
# Optional: If you register your app with a client secret on Spotify Developer Dashboard
SPOTIFY_CLIENT_SECRET=

# Frontend Redirect URI (configured in Spotify Dashboard)
VITE_SPOTIFY_CLIENT_ID=663e5f2a2950473ba037426e5343b8df
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Server Port (for local standalone run)
PORT=3001
