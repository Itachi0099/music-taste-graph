# Spotify OAuth Configuration
# Server-side Spotify Client ID
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
# Optional: Client secret (if registered on Spotify Developer Dashboard)
SPOTIFY_CLIENT_SECRET=

# Session Encryption Secret (Required for production HttpOnly refresh-token cookie)
SESSION_SECRET=your_random_32_character_session_secret_here

# Spotify Redirect URI (must be allowlisted character-for-character)
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Frontend Environment Variables (Vite client)
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id_here
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/

# Allowed Origins for CORS (comma-separated; defaults to production + localhost)
ALLOWED_ORIGINS=https://music-taste-graph.vercel.app,http://127.0.0.1:5173,http://localhost:5173

# Server Port (for local standalone run)
PORT=3001
